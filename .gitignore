apk file/
android/app/release/

# Release signing. Losing these means never being able to update an installed
# app again; committing them means anyone can sign a build that replaces it.
# Keep the keystore AND the lineage backed up somewhere private.
keystore.properties
android/keystore.properties
*.jks
*.keystore
android/signing-lineage.bin

# Scratch & temporary diagnostic dumps
scratch/
android/app/libs/sherpa-onnx-*.aar

# Live-update (OTA) bundle signing key. Back it up next to the release keystore:
# losing it means web updates cannot ship until a new APK carries a new public key.
android/live-update-private.pem
# Release outputs from scripts/build-web-bundle.mjs
release/
